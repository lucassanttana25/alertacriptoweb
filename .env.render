# Configurações para ambiente Render
# Adicione estas variáveis de ambiente no painel do Render

# Para forçar CPU-only em produção
CPU_ONLY_MODE=true

# Para controlar uso de modelos avançados
USE_ADVANCED_MODELS=false

# Para desabilitar TensorFlow completamente se necessário
USE_TENSORFLOW=false

# Configurações do TensorFlow para CPU
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0
CUDA_VISIBLE_DEVICES=-1
TF_FORCE_GPU_ALLOW_GROWTH=false

# Outras configurações úteis para produção
PYTHONUNBUFFERED=1